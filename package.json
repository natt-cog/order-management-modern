    "exceljs": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "rimraf": "^2.7.1",
